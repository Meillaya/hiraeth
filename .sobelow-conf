# Sobelow security-scan config for Hiraeth.
#
# Format: Elixir keyword list (parsed via Code.string_to_quoted/1).
# All skip entries are precise per-file or per-module justifications.
# Both `ignore_files` and `ignore` are required because Sobelow does not
# expose per-finding fingerprint-skips in the config file itself.

[
  # Fail the build on any confidence-level finding so CI is blocking.
  exit: "Low",
  format: "txt",

  # Per-file false positives. Each path enumerated below either:
  #   (a) validates every operation through a has-safe-path guard
  #       (e.g. safe_cached_file_path?/validate_relative_path/ensure_safe_cache_write_path!),
  #   (b) writes only to a hardcoded, non-user-controlled filesystem root,
  #   (c) loads from a checked-in, allowlisted manifest path,
  #   (d) calls System.cmd with binaries resolved via System.find_executable at
  #       compile-time (not user input), or
  #   (e) passes only parameterized SQL to Repo.query with $1...$N placeholders
  #       and validated, allowlisted values.
  # The Sobelow flag-list heuristic reports these as low-confidence findings
  # because the calls interleave File.* / Repo.query / System.cmd with
  # variable references; manual review confirmed each is a false positive.
  ignore_files: [
    # Traversal.FileModule (covers.ex): safe_cached_file_path? guarantees the
    # write target is under the validated cache root and is a regular file.
    # CI.System (covers.ex): System.cmd is invoked with binaries from
    # System.find_executable("magick") / System.find_executable("timeout") and
    # `source_path` / `thumbnail_path` derived from sha256(source_url) -- never
    # user input.
    "lib/hiraeth/covers.ex",

    # Traversal.FileModule: process_cover calls ensure_safe_cache_write_path!
    # before any File.write / File.rm; cached_path and thumbnail_path are
    # derived from sha256(source_url) under the validated cache root.
    "lib/hiraeth/ingestion/cover_pipeline.ex",

    # Traversal.FileModule: writes to a hardcoded `artifacts/qa/provenance`
    # audit-evidence directory; run! is invoked only by operator tasks.
    "lib/hiraeth/provenance_audit.ex",

    # Traversal.FileModule: writes the deterministic coverage report to the
    # caller-supplied output_path inside the checked-in `artifacts/qa/`
    # boundary; no user-controlled path component.
    "lib/hiraeth/real_catalog/coverage_report.ex",

    # Traversal.FileModule: load_file / load_source_authority_manifest read
    # from the checked-in `priv/catalog_sources/real_publishers/` root with
    # a fixed authoritative manifest filename.
    "lib/hiraeth/real_catalog/dataset.ex",

    # Traversal.FileModule: writes the deterministic source-artifacts manifest
    # to the checked-in `priv/catalog_sources/real_publishers/` boundary.
    "lib/hiraeth/real_catalog/source_artifacts.ex",

    # Traversal.FileModule: every fetch! / write_source_artifact! call
    # validates the source URL against the source authority manifest and the
    # SourcePolicy allowlist before any filesystem write.
    "lib/hiraeth/real_catalog/source_fetcher.ex",

    # Traversal.FileModule: artifact_store.ex runs every path through
    # validate_relative_path, which rejects absolute paths, ".." components,
    # and public/static namespaces.
    "lib/hiraeth/ingestion/source_snapshot/artifact_store.ex",

    # Traversal.FileModule: inventory.ex reads from the checked-in
    # ProviderManifest.default_dir() and the allowlisted provider scripts
    # directory; no user-supplied path.
    "lib/hiraeth/ingestion/provider_backfill/inventory.ex",

    # Traversal.FileModule: ProviderManifest.load! is called with
    # Path.join(ProviderManifest.default_dir(), "<provider>.json") paths
    # only -- see operator_manifest.ex and the ingestion worker.
    "lib/hiraeth/ingestion/provider_manifest.ex",

    # DOS.StringToAtom: get_in_map uses String.to_atom only over a bounded
    # list of hardcoded key strings (e.g. ["edition", "isbn_13"]); never
    # user-supplied data.
    "lib/hiraeth/ingestion/phases/apply_candidates.ex",

    # DOS.StringToAtom: enqueue_phase_intent converts a ProviderRun.status
    # value that is constrained by the Ash `validate one_of(:status, [...])`
    # validation in provider_run.ex to five canonical strings.
    "lib/hiraeth/ingestion/provider_scheduler.ex",

    # SQL.Query: every Repo.query call uses $-placeholder parameter binding
    # ($1, $2, ...) with values that are normalized via normalize_text,
    # normalize_identifier, normalize_contributor_role, normalize_sort, or
    # enum-validated literal filters -- the where/order/limit strings are
    # composed from static SQL fragments and integer $N indices.
    "lib/hiraeth_web/public_catalog.ex"
  ],

  # Module-level skip: only justified because the CSP header is added in
  # TODO 22 of the production-readiness plan (Wave 4 web hardening) with a
  # precise put_secure_browser_headers override on the `:browser` pipeline.
  # Until TODO 22 lands, the single Config.CSP finding (router.ex:10) is a
  # known-tracked issue. The full TODO 22 commit
  # (`security(prod-ready): add content-security-policy`) will remove this
  # skip entry.
  ignore: ["Config.CSP"],

  # Honor `# sobelow_skip ["Module"]` comments in source code.
  skip: true,

  out: nil,
  private: false,
  router: nil,
  threshold: "Low",
  verbose: false,
  version: false
]
